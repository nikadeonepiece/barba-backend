# Copiar como `.env` y completar. NUNCA subir el `.env` real con valores.

# ==============================================
#  SEGURIDAD
# ==============================================
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=15m
# Días de vida del refresh token (cookie httpOnly). Con el access token de 15m,
# la sesión dura este tiempo sin volver a pedir contraseña, renovando sola.
REFRESH_TOKEN_EXPIRES_DAYS=30

# OBLIGATORIO en el servidor: sin `production`, la cookie del refresh token se emite
# SIN la marca `secure` y viaja también por HTTP.
NODE_ENV=production

PORT=3777

# ==============================================
#  BASE DE DATOS (MariaDB)
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=ESTUDIOBARBA

# ==============================================
#  CIFRADO DE CREDENCIALES SUNAT (vencimientos/credenciales-crypto.service.ts)
#  Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#  ⚠️ Si se cambia, las credenciales SUNAT ya guardadas quedan indescifrables y hay
#  que volver a cargarlas una por una. Al migrar de servidor, copiar LA MISMA.
# ==============================================
CREDENCIALES_ENCRYPTION_KEY=

# ==============================================
#  FASE 2 — cron de sincronización SUNAT
#  Dejar en false hasta que el scraping esté verificado en el servidor
#  (requiere además `npx playwright install chromium`).
# ==============================================
ENABLE_SUNAT_SYNC_CRON=false

# ==============================================
#  FASE 3 — IA (opcional)
#  Sin esta variable el resumen diario y la detección de inconsistencias siguen
#  funcionando con texto armado por código. El ÚNICO que la exige es el asistente
#  de redacción de correos (da error al usarlo si falta).
# ==============================================
# ANTHROPIC_API_KEY=

# ==============================================
#  CORREOS (SMTP)
# ==============================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ERP <correo@dominio.com>"

# ==============================================
#  DEEP LINKING — base de los links que salen en los correos.
#  En producción DEBE ser la URL pública del frontend, no localhost.
# ==============================================
FRONTEND_URL=https://barba.difusioneslaborales.com

# ==============================================
#  CASILLA ELECTRÓNICA SUNAFIL
#  SUNAFIL no publica API para la casilla: el portal es JSF/PrimeFaces y se lee
#  con Playwright. El acceso de EMPLEADOR no tiene clave propia — usa la misma
#  Clave SOL de SUNAT que ya vive cifrada en la tabla `empresa`, así que acá NO
#  va ninguna credencial.
#
#  Esta variable es solo el client_id PÚBLICO de la aplicación de SUNAFIL en
#  SUNAT (viaja en el JS de una página pública, no es un secreto). Se deja
#  configurable para poder corregirlo sin desplegar código si SUNAFIL lo rota.
#  Si se omite, el sistema usa el valor verificado el 20/08/2026.
# ==============================================
# SUNAFIL_CASILLA_CLIENT_ID=b6474e23-8a3b-4153-b301-dafcc9646250
